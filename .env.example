# Copy to .env and fill in from: Firebase console > Project settings > Your apps > Web app (</>)
# These are PUBLIC web identifiers (security comes from firestore.rules + Auth),
# but keep .env out of git anyway. NEVER put service-account / admin-SDK keys here.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=

# Optional: local Flask backend used ONLY for Word/PDF export
WIR_API_BASE_URL=http://localhost:5000/api
